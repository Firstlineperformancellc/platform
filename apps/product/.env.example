# Copy to .env — values for the FLP dev project live in the Supabase dashboard (Project Settings → API).
# The anon key is public and RLS-restricted; never put the service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
EXPO_PUBLIC_SITE_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=https://api-dev.firstlineperform.com
