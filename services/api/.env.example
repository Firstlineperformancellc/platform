# Copy to .env.dev (for flp-dev-01) or .env.prod (for flp-web-01). Both are gitignored.
# deploy/deploy-dev.sh copies .env.dev to /var/www/flp-api/.env on the server.
# Scott never types these values; the account owner pastes them into the file directly.

APP_ENV=dev
PORT=3200

# Supabase: Project Settings -> API. The service_role key bypasses RLS; it lives ONLY here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Filled in as each provider is wired in.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=
RESEND_API_KEY=

# Internal timer (services/api/deploy/flp-api-tick.*) and outbound links/mail
TICK_SECRET=
APP_ORIGIN=https://dev.firstlineperform.com
MAIL_FROM=First Line Performance <no-reply@mail.firstlineperform.com>
